{
  "name": "@hungerly/utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free helpers shared by Hungerly apps (money, formatting, phone numbers).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@hungerly/types": "workspace:*"
  },
  "devDependencies": {
    "@hungerly/config": "workspace:*",
    "@types/jest": "30.0.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "jest": "~30.5.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
