{
  "name": "@hungerly/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API contract (Zod schemas shared by the API server and apps) and a typed fetch client.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hungerly/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
