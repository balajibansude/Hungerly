{
  "name": "@hungerly/app-core",
  "version": "0.1.0",
  "private": true,
  "description": "React (non-UI) building blocks shared by Hungerly apps: data hook, service errors and the services context.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@hungerly/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "jest": "~30.5.2",
    "react": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
