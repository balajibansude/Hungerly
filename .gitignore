# =============================================================================
# Hungerly .gitignore
# Ignores only locally generated files and sensitive material.
# Environment templates (.env.example) are committed; real values never are.
# =============================================================================

# --- Environment files and secrets ------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example
.secrets/
secrets/
*.pem
*.key
*.crt
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
key.properties
*service-account*.json
*serviceAccount*.json
credentials.json
google-services.json
GoogleService-Info.plist

# --- Node / TypeScript (admin web app, generated TS client) -----------------
node_modules/
.pnpm-store/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build output and caches -------------------------------------------------
dist/
build/
coverage/
.turbo/
.cache/
tmp/
.tmp/

# --- Python (backend) --------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Flutter / Dart (mobile apps and shared Dart packages) -------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/flutter_sdk
**/android/local.properties
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
*.xcuserstate
xcuserdata/
DerivedData/
*.ipa
*.apk
*.aab

# --- Infrastructure ----------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak
docker-compose.override.yml

# --- Local data ---------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
pgdata/
redis-data/
minio-data/

# --- Logs ----------------------------------------------------------------------
logs/
*.log

# --- OS / editor temporary files ----------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak
.~lock.*#
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# --- Local reference images (third-party branding / customer data; never commit) ---
/Restaurant App reference images/
/design-references/
/card1.jpeg
/card2.jpeg
/Foodu_ Food Delivery App UI for Figma - Freebiesbug.jpeg
/Swaadone Food Delivery Logo.png

# Expo local development files
.expo/
