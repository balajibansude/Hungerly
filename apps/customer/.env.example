# Copy to .env.local and adjust. Values are inlined at build time (restart Expo after changes).

# Swaadone API base URL including /api/v1. Leave unset to run on the built-in mock services.
# On a phone, use your computer's LAN IP (not localhost).
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1

# Set to true to force the mock services even when an API URL is set.
EXPO_PUBLIC_USE_MOCK=false
