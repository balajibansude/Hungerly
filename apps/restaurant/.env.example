# Restaurant app environment (copy to .env.local; never commit real values)
# API base URL including /api/v1. On a phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
# Google Maps keys for development/store builds (Expo Go needs none)
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
