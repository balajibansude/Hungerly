# Copy with `pnpm --filter @hungerly/api env:generate` (creates .env with fresh secrets).
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://hungerly:<password>@localhost:5433/hungerly
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TOKEN_HASH_SECRET=
FIELD_ENCRYPTION_KEY=
STORAGE_DIR=./storage
# OTP_DEV_FIXED_CODE=123456          # development only; rejected when NODE_ENV=production
# MSG91_AUTH_KEY=                    # SMS OTP delivery (required in production)
# MSG91_OTP_TEMPLATE_ID=
# Business policy (confirm before launch; defaults in src/config.ts)
# DEFAULT_COMMISSION_BPS=1800
# COMMISSION_TAX_BPS=1800
# SETTLEMENT_HOLD_DAYS=2
# MIN_WITHDRAWAL_MINOR=50000
# COUPON_AUTO_MAX_PERCENT_BPS=3000
# COUPON_AUTO_MAX_FLAT_MINOR=15000
# COUPON_AUTO_MAX_CAP_MINOR=20000
# COUPON_AUTO_MAX_DURATION_DAYS=31
# RazorpayX payouts: unset = disabled. rzp_test_ keys = sandbox (no real money).
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
# RAZORPAYX_WEBHOOK_SECRET=
# RAZORPAYX_PAYOUT_MODE=IMPS
